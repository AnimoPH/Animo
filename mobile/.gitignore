# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Supabase CLI local dev artifacts (generated by `supabase start`; note
# supabase/.temp is intentionally NOT ignored here - it's tracked in this
# repo and holds the linked-project reference the whole team shares)
supabase/.branches
supabase/.temp/start-secrets/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
CLAUDE.md
AGENTS.md
.claude/
